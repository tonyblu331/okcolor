{
  "name": "ok-actually",
  "version": "1.0.0",
  "description": "Zero-config, build-time color modernizer for Vite and Tailwind CSS",
  "license": "MIT",
  "author": "ok-actually contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonyblu331/ok-actually.git"
  },
  "bugs": {
    "url": "https://github.com/tonyblu331/ok-actually/issues"
  },
  "homepage": "https://tonyblu331.github.io/ok-actually",
  "keywords": [
    "oklch",
    "color",
    "css",
    "vite",
    "tailwindcss",
    "build-tools",
    "color-conversion",
    "design-systems"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "ok-actually": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node node_modules/tsdown/dist/run.js",
    "build:docs": "cd packages/docs && astro build",
    "dev": "node node_modules/tsdown/dist/run.js --watch",
    "dev:docs": "cd packages/docs && astro dev",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write src",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "tsdown": "0.10.2",
    "typescript": "5.9.3",
    "vite": "8.0.14",
    "vitest": "3.2.4"
  },
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
