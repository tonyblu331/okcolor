{
  "name": "okcolor",
  "version": "1.0.0",
  "description": "Zero-config, build-time color modernizer for Vite and Tailwind CSS",
  "license": "MIT",
  "author": "Antonio Bonet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyblu331/okcolor.git"
  },
  "bugs": {
    "url": "https://github.com/tonyblu331/okcolor/issues"
  },
  "homepage": "https://tonyblu331.github.io/okcolor",
  "keywords": [
    "oklch",
    "color",
    "css",
    "vite",
    "tailwindcss",
    "build-tools",
    "color-conversion",
    "design-systems"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "okcolor": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
	"scripts": {
		"build": "npm run build:wasm && npm run build:ts && npm run build:copy",
		"build:wasm": "wasm-pack build packages/core-wasm --target web --release --no-opt",
		"build:ts": "node node_modules/tsdown/dist/run.js",
		"build:copy": "node scripts/copy-wasm.mjs",
		"build:docs": "cd packages/docs && astro build",
		"dev": "node node_modules/tsdown/dist/run.js --watch",
		"dev:docs": "cd packages/docs && astro dev",
		"test": "vitest run",
		"bench": "vitest bench",
		"lint": "eslint src",
		"format": "prettier --write src",
		"prepublishOnly": "npm run build"
	},
  "devDependencies": {
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "tsdown": "0.10.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.32.1",
    "vite": "8.0.14",
    "vitest": "3.2.4"
  },
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
	"dependencies": {}
}
