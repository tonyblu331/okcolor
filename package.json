{
  "name": "@tonybonet/okcolor",
  "version": "1.0.0",
  "description": "Frontend-first, build-time OKLCH modernizer for Vite apps and design systems",
  "license": "MIT",
  "author": "Antonio Bonet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyblu331/okcolor.git"
  },
  "bugs": {
    "url": "https://github.com/tonyblu331/okcolor/issues"
  },
  "homepage": "https://tonyblu331.github.io/okcolor",
  "keywords": [
    "oklch",
    "color",
    "css",
    "vite",
    "tailwindcss",
    "build-tools",
    "color-conversion",
    "design-systems"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "okcolor": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:wasm": "wasm-pack build packages/core-wasm --target web --release --no-opt",
    "build:optimize": "node scripts/optimize-wasm.mjs",
    "build:ts": "node node_modules/tsdown/dist/run.mjs",
    "build:copy": "node scripts/copy-wasm.mjs",
    "build:docs": "npm -w packages/docs run build",
    "dev": "node node_modules/tsdown/dist/run.mjs --watch",
    "dev:docs": "cd packages/docs && astro dev",
    "pretest": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run",
    "bench": "node node_modules/vitest/vitest.mjs bench",
    "lint": "eslint src",
    "format": "prettier --write src",
    "prepublishOnly": "npm run build",
    "test:e2e": "npm run build && node node_modules/vitest/vitest.mjs run --config vitest.e2e.config.ts",
    "bench:ci": "node -e \"require('node:fs').mkdirSync('.tmp',{recursive:true})\" && node node_modules/vitest/vitest.mjs bench bench/bottleneck.bench.ts bench/throughput.bench.ts --outputJson=.tmp/bench-results.json && node scripts/check-bench-regression.mjs .tmp/bench-results.json bench/baseline.json"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "apca-w3": "^0.1.9",
    "binaryen": "^129.0.0",
    "colorjs.io": "^0.6.1",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "tsdown": "^0.22.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.32.1",
    "vite": "8.0.14",
    "vitest": "3.2.4"
  },
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
