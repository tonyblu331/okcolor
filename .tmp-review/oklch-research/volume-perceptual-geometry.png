<body>
  <div id="root"></div>

  <noscript>
    <main class="slides">
      <!-- Slide 1 -->
      <section class="slide">
        <h1>Introducing Volume</h1>
        <div class="tagline">GPS for Color</div>
        <p>
          Volume turns color selection from a flat swatch-hunt into a sculptural,
          3D design journey. Explore, build, and manipulate color structures as
          tangible objects—revealing hidden harmonies no flat picker can show.
        </p>
        <img src="/assets/poster_introducing.png"
             alt="Volume 3D OKLCH preview" />
      </section>

      <!-- Slide 2 -->
      <section class="slide">
        <h2>Perceptual Geometry</h2>
        <p>
          Powered by the perceptually-uniform OKLCH color space, chroma radiates
          uniformly from neutral gray, lightness is vertical, and hue distances
          stay constant—rotate by any degree and get an equal perceptual shift.
        </p>
        <img src="/assets/poster_perceptual.png"
             alt="Perceptual OKLCH geometry" />
      </section>

      <!-- Slide 3 -->
      <section class="slide">
        <h2>No Side-Effects</h2>
        <p>
          Cycle through hues at constant lightness, increase chroma for brilliance,
          or shift brightness across your entire palette—zero hue drift, zero
          surprises.
        </p>
        <img src="/assets/poster_noside.png"
             alt="No unintended hue shifts" />
      </section>

      <!-- Slide 4 -->
      <section class="slide">
        <h2>Modular Editing</h2>
        <p>
          Extract segments of your palette for precise tweaks—adjust chroma,
          lightness, or hue on each subgroup—then snap them back together,
          preserving every node’s spatial relationships.
        </p>
        <img src="/assets/poster_modular.png"
             alt="Modular palette editing in Volume" />
      </section>

      <!-- Slide 5 -->
      <section class="slide">
        <h2>Try Volume</h2>
        <p>
          Whether you’re crafting brands, UI themes, or art-direction mood boards,
          Volume’s 3D color structures give unprecedented insight and precision—
          ensuring every palette is harmonious and human-centered.
        </p>
        <img src="/assets/poster_introducing.png"
             alt="Try Volume call-to-action" />
      </section>
    </main>
  </noscript>

  <!-- Boot your SPA (hydrateRoot in main.jsx) -->
