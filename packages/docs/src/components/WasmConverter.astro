---
import ConverterControls from './converter/ConverterControls.astro'
import ConverterCssOutput from './converter/ConverterCssOutput.astro'
import ConverterOutput from './converter/ConverterOutput.astro'
import GamutViewer from './converter/GamutViewer.astro'
---

<section class="wasm-converter" data-ok-converter>
  <header class="converter-header">
    <p>Color converter</p>
    <h2>Inspect the conversion, not the decoration.</h2>
    <span>Powered by the same Rust/WASM engine used by okcolor.</span>
  </header>

  <main class="converter-shell" aria-label="Color conversion result and gamut views">
    <GamutViewer />
    <ConverterControls />
    <section class="converter-results" aria-label="Conversion output">
      <ConverterOutput />
      <ConverterCssOutput />
    </section>
  </main>
</section>

<script>
  import init, {
    convert_color,
    expand_oklch_chroma,
    fit_oklch_gamut,
    oklch_chroma_max,
    oklch_in_gamut,
    oklch_relative_luminance,
  } from '../../../core-wasm/pkg/okcolor_core.js'
  import wasmUrl from '../../../core-wasm/pkg/okcolor_core_bg.wasm?url'

  const roots = document.querySelectorAll('[data-ok-converter]')

  for (const root of roots) {
    setupConverter(root)
  }

  async function setupConverter(root) {
    const elements = {
      input: root.querySelector('[data-color-input]'),
      picker: root.querySelector('[data-color-picker]'),
      mappingToggle: root.querySelector('[data-mapping-toggle]'),
      mappingControls: root.querySelector('[data-mapping-controls]'),
      mappedOnly: root.querySelectorAll('[data-mapped-only]'),
      modeButtons: root.querySelectorAll('[data-mode-button]'),
      gamut: root.querySelector('[data-gamut-select]'),
      strength: root.querySelector('[data-strength]'),
      strengthLabel: root.querySelector('[data-strength-label]'),
      lightnessRange: root.querySelector('[data-lightness-range]'),
      chromaRange: root.querySelector('[data-chroma-range]'),
      hueRange: root.querySelector('[data-hue-range]'),
      lightnessLabel: root.querySelector('[data-lightness-label]'),
      chromaLabel: root.querySelector('[data-chroma-label]'),
      hueLabel: root.querySelector('[data-hue-label]'),
      status: root.querySelector('[data-status]'),
      sourceSwatch: root.querySelector('[data-source-swatch]'),
      resultSwatch: root.querySelector('[data-result-swatch]'),
      oklchOutput: root.querySelector('[data-oklch-output]'),
      resultOutput: root.querySelector('[data-result-output]'),
      fallbackOutput: root.querySelector('[data-fallback-output]'),
      gamutOutput: root.querySelector('[data-gamut-output]'),
      contrastChoice: root.querySelector('[data-contrast-choice]'),
      contrastRatio: root.querySelector('[data-contrast-ratio]'),
      contrastNote: root.querySelector('[data-contrast-note]'),
      cssOutput: root.querySelector('[data-css-output]'),
      copyOutput: root.querySelector('[data-copy-output]'),
      canvasView: root.querySelector('[data-gamut-view]'),
      viewTitle: root.querySelector('[data-view-title]'),
      viewDescription: root.querySelector('[data-view-description]'),
      viewButtons: root.querySelectorAll('[data-view-button]'),
      advancedViewsToggle: root.querySelector('[data-advanced-views-toggle]'),
      advancedViewButtons: root.querySelectorAll('[data-advanced-view]'),
      examples: root.querySelectorAll('[data-example]'),
    }

    const state = {
      mode: 'expand',
      ready: false,
      lastCss: '',
      lastResult: null,
      mappingEnabled: false,
      visibleMappings: { expand: true, saturate: true },
      advancedViewsEnabled: false,
      isDraggingGamut: false,
      viewMode: '2d',
      isRotatingVolume: false,
      volumePointer: null,
      volumeRotation: { x: 0.58, y: -0.72 },
    }

    bindConverterEvents(elements, state, render)

    try {
      await init({ module_or_path: wasmUrl })
      state.ready = true
      setStatus(elements, 'WASM engine ready. Try a hex, rgb(), hsl(), hwb(), named color, or OKLCH value.', 'ready')
      render()
    } catch (error) {
      setStatus(elements, `WASM failed to load: ${error instanceof Error ? error.message : String(error)}`, 'error')
    }

    if ('ResizeObserver' in window) {
      const observer = new ResizeObserver(() => {
        window.requestAnimationFrame(render)
      })
      observer.observe(elements.canvasView)
    }

    function render() {
      if (!state.ready) return

      const sourceText = elements.input.value.trim()
      const targetGamut = elements.gamut.value
      const strength = Number(elements.strength.value)
      elements.strengthLabel.textContent = state.mode === 'expand' ? `${Math.round(strength * 100)}%` : `+${Math.round(strength * 100)}%`

      const oklchCss = convert_color(sourceText, 'oklch')
      const fallbackCss = convert_color(sourceText, 'hex') || sourceText

      if (!oklchCss) {
        state.lastResult = null
        state.lastCss = ''
        setStatus(elements, 'Unsupported color. Use hex, rgb(), hsl(), hwb(), named colors, color(srgb), or OKLCH.', 'error')
        elements.oklchOutput.textContent = 'No conversion'
        elements.resultOutput.textContent = 'No result'
        elements.fallbackOutput.textContent = 'No fallback'
        elements.gamutOutput.textContent = 'Waiting for a valid color'
        elements.contrastChoice.textContent = 'No result'
        elements.contrastRatio.textContent = 'No ratio'
        elements.contrastNote.textContent = 'Enter a supported CSS color to see contrast feedback.'
        elements.sourceSwatch.style.background = 'transparent'
        elements.resultSwatch.style.background = 'transparent'
        elements.cssOutput.textContent = '/* Enter a supported CSS color. */'
        clearCanvas(elements.canvasView)
        return
      }

      const source = parseOklch(oklchCss)
      if (!source) {
        setStatus(elements, 'The engine returned an OKLCH value that this demo could not parse.', 'error')
        return
      }

      syncChannelControls(elements, source)

      const sourceInTarget = oklch_in_gamut(source.l, source.c, source.h, targetGamut)
      const visibleMappings = state.mappingEnabled ? getVisibleMappings(source, targetGamut, strength, state.visibleMappings) : []
      const activeMapping = visibleMappings.find((entry) => entry.mode === state.mode) ?? visibleMappings[0]
      const result =
        activeMapping?.result ?? {
          color: source,
          cMax: oklch_chroma_max(source.l, source.h, targetGamut) || 0,
          inGamut: sourceInTarget,
          neutralSkipped: false,
        }
      const resultCss = formatOklch(result.color)
      const resultFallback = fallbackCss
      const resultInTarget = oklch_in_gamut(result.color.l, result.color.c, result.color.h, targetGamut)
      const contrast = contrastSummary(result.color)
      const modeLabel = activeMapping?.mode === 'expand' ? 'expanded' : 'saturated'
      const mappingSummary = visibleMappings.map((entry) => entry.label).join(' + ')

      state.lastResult = { source, result: result.color, targetGamut, mappingEnabled: state.mappingEnabled, visibleMappings }
      state.lastCss = buildCssOutput(fallbackCss, resultCss, targetGamut)

      elements.oklchOutput.textContent = oklchCss
      elements.resultOutput.textContent = resultCss
      elements.fallbackOutput.textContent = resultFallback
      elements.gamutOutput.textContent = visibleMappings.length
        ? `${targetGamutLabel(targetGamut)}: source ${sourceInTarget ? 'inside' : 'outside'}, ${activeMapping.label.toLowerCase()} ${resultInTarget ? 'inside' : 'outside'} · Cmax ${formatMetric(result.cMax)}`
        : `${targetGamutLabel(targetGamut)}: source ${sourceInTarget ? 'inside' : 'outside'} · Cmax ${formatMetric(result.cMax)}`
      elements.contrastChoice.textContent = contrast.foreground
      elements.contrastRatio.textContent = `${contrast.ratio.toFixed(2)}:1`
      elements.contrastNote.textContent = `${contrast.status} for normal text against ${contrast.foreground.toLowerCase()} foreground. White ${contrast.whiteRatio.toFixed(2)}:1 · black ${contrast.blackRatio.toFixed(2)}:1.`
      elements.cssOutput.textContent = state.lastCss
      elements.sourceSwatch.style.background = oklchCss
      elements.resultSwatch.style.background = resultCss

      syncPicker(elements, fallbackCss)
      setStatus(
        elements,
        visibleMappings.length
          ? result.neutralSkipped
            ? 'Neutral color detected: chroma expansion skipped to preserve gray intent.'
            : `Showing ${mappingSummary} movement from the original color. Current output is ${modeLabel}.`
          : 'Source shown without gamut mapping. Enable mapping to compare Expand or Saturate.',
        'ready',
      )
      syncViewerCopy(elements, state.viewMode)
      if (state.viewMode === '3d') {
        drawGamutVolume(elements.canvasView, source, visibleMappings, targetGamut, state.volumeRotation)
      } else if (state.viewMode === 'triangle') {
        drawGamutTriangle(elements.canvasView, source, visibleMappings, targetGamut)
      } else {
        drawGamutSlice(elements.canvasView, source, visibleMappings, targetGamut)
      }
    }
  }

  function bindConverterEvents(elements, state, render) {
    elements.input.addEventListener('input', render)
    elements.picker.addEventListener('input', () => {
      elements.input.value = elements.picker.value
      render()
    })
    elements.gamut.addEventListener('change', render)
    elements.strength.addEventListener('input', render)
    elements.mappingToggle?.addEventListener('click', () => {
      state.mappingEnabled = !state.mappingEnabled
      elements.mappingToggle.classList.toggle('is-active', state.mappingEnabled)
      elements.mappingToggle.setAttribute('aria-pressed', state.mappingEnabled ? 'true' : 'false')
      if (elements.mappingControls) elements.mappingControls.hidden = !state.mappingEnabled
      for (const mappedElement of elements.mappedOnly) {
        mappedElement.hidden = !state.mappingEnabled
      }
      render()
    })
    elements.lightnessRange.addEventListener('input', () => {
      updateInputFromChannels(elements)
      render()
    })
    elements.chromaRange.addEventListener('input', () => {
      updateInputFromChannels(elements)
      render()
    })
    elements.hueRange.addEventListener('input', () => {
      updateInputFromChannels(elements)
      render()
    })
    elements.canvasView.addEventListener('pointerdown', (event) => {
      if (state.viewMode === '3d') {
        state.isRotatingVolume = true
        state.volumePointer = { x: event.clientX, y: event.clientY }
        safelySetPointerCapture(elements.canvasView, event.pointerId)
        return
      }
      state.isDraggingGamut = true
      safelySetPointerCapture(elements.canvasView, event.pointerId)
      pickFromGamut(event, elements, state, render)
    })
    elements.canvasView.addEventListener('pointermove', (event) => {
      if (state.viewMode === '3d') {
        if (!state.isRotatingVolume || !state.volumePointer) return
        const dx = event.clientX - state.volumePointer.x
        const dy = event.clientY - state.volumePointer.y
        state.volumePointer = { x: event.clientX, y: event.clientY }
        state.volumeRotation.y += dx * 0.012
        state.volumeRotation.x = clamp(state.volumeRotation.x + dy * 0.012, -1.25, 1.25)
        render()
        return
      }
      if (!state.isDraggingGamut) return
      pickFromGamut(event, elements, state, render)
    })
    elements.canvasView.addEventListener('pointerup', (event) => {
      state.isDraggingGamut = false
      state.isRotatingVolume = false
      state.volumePointer = null
      safelyReleasePointerCapture(elements.canvasView, event.pointerId)
    })
    elements.canvasView.addEventListener('pointercancel', () => {
      state.isDraggingGamut = false
      state.isRotatingVolume = false
      state.volumePointer = null
    })

    for (const button of elements.viewButtons) {
      button.addEventListener('click', () => {
        if (button.hidden) return
        state.viewMode = button.dataset.viewButton
        for (const candidate of elements.viewButtons) {
          const active = candidate === button
          candidate.classList.toggle('is-active', active)
          candidate.setAttribute('aria-pressed', active ? 'true' : 'false')
        }
        render()
      })
    }

    elements.advancedViewsToggle?.addEventListener('click', () => {
      state.advancedViewsEnabled = !state.advancedViewsEnabled
      elements.advancedViewsToggle.classList.toggle('is-active', state.advancedViewsEnabled)
      elements.advancedViewsToggle.setAttribute('aria-pressed', state.advancedViewsEnabled ? 'true' : 'false')
      for (const button of elements.advancedViewButtons) {
        button.hidden = !state.advancedViewsEnabled
      }
      if (!state.advancedViewsEnabled && state.viewMode !== '2d') {
        state.viewMode = '2d'
        for (const candidate of elements.viewButtons) {
          const active = candidate.dataset.viewButton === '2d'
          candidate.classList.toggle('is-active', active)
          candidate.setAttribute('aria-pressed', active ? 'true' : 'false')
        }
      }
      render()
    })

    for (const button of elements.modeButtons) {
      button.addEventListener('click', () => {
        const mode = button.dataset.modeButton
        const visibleCount = Object.values(state.visibleMappings).filter(Boolean).length
        if (state.visibleMappings[mode] && visibleCount === 1) return
        state.visibleMappings[mode] = !state.visibleMappings[mode]
        state.mode = mode
        button.classList.toggle('is-active', state.visibleMappings[mode])
        button.setAttribute('aria-pressed', state.visibleMappings[mode] ? 'true' : 'false')
        render()
      })
    }

    for (const example of elements.examples) {
      example.addEventListener('click', () => {
        elements.input.value = example.dataset.example
        render()
      })
    }

    elements.copyOutput.addEventListener('click', async () => {
      if (!state.lastCss) return
      try {
        await navigator.clipboard.writeText(state.lastCss)
        elements.copyOutput.textContent = 'Copied'
        window.setTimeout(() => {
          elements.copyOutput.textContent = 'Copy'
        }, 1200)
      } catch {
        elements.copyOutput.textContent = 'Copy failed'
        window.setTimeout(() => {
          elements.copyOutput.textContent = 'Copy'
        }, 1200)
      }
    })
  }

  function safelySetPointerCapture(element, pointerId) {
    try {
      element.setPointerCapture?.(pointerId)
    } catch {
      // Synthetic pointer events and some embedded browsers may not have an active pointer capture target.
    }
  }

  function safelyReleasePointerCapture(element, pointerId) {
    try {
      element.releasePointerCapture?.(pointerId)
    } catch {
      // Ignore stale capture ids; the drag state has already been reset.
    }
  }

  function pickFromGamut(event, elements, state, render) {
    const current = parseOklch(convert_color(elements.input.value.trim(), 'oklch') || '')
    if (!current) return

    const pick = state.viewMode === 'triangle'
      ? pickTriangleFromCanvas(elements.canvasView, event, current.h, elements.gamut.value)
      : pickHueChromaFromCanvas(elements.canvasView, event, current.l, elements.gamut.value)
    elements.input.value = formatOklch(pick)
    render()
  }

  function pickHueChromaFromCanvas(canvas, event, lightness, targetGamut) {
    const rect = canvas.getBoundingClientRect()
    const width = Math.max(1, rect.width || 640)
    const height = Math.max(1, rect.height || 360)
    const l = clamp(lightness, 0.02, 0.98)
    const x = clamp(event.clientX - rect.left, 0, width)
    const y = clamp(event.clientY - rect.top, 0, height)
    const hue = normalizeHue((x / width) * 360)
    const viewMaxC = getPlaneMaxChroma(l, targetGamut)
    const cMax = oklch_chroma_max(l, hue, targetGamut) || 0
    const c = clamp((1 - y / height) * viewMaxC, 0, cMax)

    return { l, c, h: hue }
  }


  function pickTriangleFromCanvas(canvas, event, hue, targetGamut) {
    const rect = canvas.getBoundingClientRect()
    const frame = getTriangleFrame(Math.max(1, rect.width || 640), Math.max(1, rect.height || 360))
    const x = clamp((event.clientX - rect.left - frame.x) / frame.width, 0, 1)
    const y = clamp(1 - (event.clientY - rect.top - frame.y) / frame.height, 0, 1)
    const halfWidth = Math.max(0.001, (1 - y) * 0.5)
    const left = 0.5 - halfWidth
    const right = 0.5 + halfWidth
    const l = y > 0.999 ? 0.5 : clamp((clamp(x, left, right) - left) / Math.max(0.001, right - left), 0, 1)
    const cMax = oklch_chroma_max(l, hue, targetGamut) || 0

    return { l, c: clamp(y * cMax, 0, cMax), h: normalizeHue(hue) }
  }

  function transformColor(source, targetGamut, strength, mode) {
    if (mode === 'expand') {
      const expanded = parseTransform(expand_oklch_chroma(source.l, source.c, source.h, targetGamut, strength))
      if (expanded) return expanded
    }

    if (source.c < 0.02) {
      return {
        color: source,
        cMax: oklch_chroma_max(source.l, source.h, targetGamut) || 0,
        inGamut: oklch_in_gamut(source.l, source.c, source.h, targetGamut) || false,
        neutralSkipped: true,
      }
    }

    const boosted = {
      l: source.l,
      c: source.c * (1 + strength),
      h: source.h,
    }
    const fitted = parseTransform(fit_oklch_gamut(boosted.l, boosted.c, boosted.h, targetGamut))
    if (fitted) return fitted

    return {
      color: source,
      cMax: source.c,
      inGamut: oklch_in_gamut(source.l, source.c, source.h, targetGamut) || false,
      neutralSkipped: false,
    }
  }

  function getVisibleMappings(source, targetGamut, strength, visibleMappings) {
    return [
      { mode: 'expand', label: 'Expand', stroke: '#111111' },
      { mode: 'saturate', label: 'Saturate', stroke: '#f05a00' },
    ]
      .filter((entry) => visibleMappings[entry.mode])
      .map((entry) => ({
        ...entry,
        result: transformColor(source, targetGamut, strength, entry.mode),
      }))
  }

  function parseTransform(value) {
    if (!value) return null
    try {
      const parsed = JSON.parse(value)
      return {
        color: {
          l: Number(parsed.l),
          c: Number(parsed.c),
          h: Number(parsed.h),
        },
        cMax: Number(parsed.cMax),
        inGamut: Boolean(parsed.inGamut),
        neutralSkipped: Boolean(parsed.neutralSkipped),
      }
    } catch {
      return null
    }
  }

  function parseOklch(value) {
    const match = value.match(/oklch\(\s*([\d.]+)%\s+([\d.]+)\s+([\d.]+)/i)
    if (!match) return null
    return {
      l: Number(match[1]) / 100,
      c: Number(match[2]),
      h: Number(match[3]),
    }
  }

  function formatOklch(color) {
    return `oklch(${(color.l * 100).toFixed(2)}% ${color.c.toFixed(5)} ${normalizeHue(color.h).toFixed(2)})`
  }

  function buildCssOutput(fallbackCss, resultCss, targetGamut) {
    const gamutMedia = targetGamut === 'p3' ? '@media (color-gamut: p3)' : '@supports (color: oklch(0.5 0.1 40))'

    if (targetGamut === 'p3') {
      return `:root {\n  --brand-color: ${fallbackCss};\n}\n\n${gamutMedia} {\n  @supports (color: oklch(0.5 0.1 40)) {\n    :root {\n      --brand-color: ${resultCss};\n    }\n  }\n}`
    }

    return `:root {\n  --brand-color: ${fallbackCss};\n}\n\n${gamutMedia} {\n  :root {\n    --brand-color: ${resultCss};\n  }\n}`
  }

  function contrastSummary(background) {
    const y = oklch_relative_luminance(background.l, background.c, background.h)
    const whiteRatio = wcagContrastRatio(1, y)
    const blackRatio = wcagContrastRatio(0, y)
    const foreground = whiteRatio >= blackRatio ? 'White' : 'Black'
    const ratio = Math.max(whiteRatio, blackRatio)

    return {
      foreground,
      ratio,
      whiteRatio,
      blackRatio,
      status: ratio >= 4.5 ? 'Passes WCAG 2 AA' : 'Fails WCAG 2 AA',
    }
  }

  function wcagContrastRatio(a, b) {
    const lighter = Math.max(a, b)
    const darker = Math.min(a, b)
    return (lighter + 0.05) / (darker + 0.05)
  }

  function syncPicker(elements, fallbackCss) {
    if (/^#[0-9a-f]{6}$/i.test(fallbackCss)) {
      elements.picker.value = fallbackCss
    }
  }

  function syncChannelControls(elements, color) {
    elements.lightnessRange.value = String(clamp(color.l, 0, 1))
    elements.chromaRange.value = String(clamp(color.c, 0, 0.42))
    elements.hueRange.value = String(normalizeHue(color.h))
    elements.lightnessLabel.textContent = `${Math.round(color.l * 100)}%`
    elements.chromaLabel.textContent = color.c.toFixed(3)
    elements.hueLabel.textContent = `${normalizeHue(color.h).toFixed(1)}°`
  }

  function updateInputFromChannels(elements) {
    elements.input.value = formatOklch({
      l: Number(elements.lightnessRange.value),
      c: Number(elements.chromaRange.value),
      h: Number(elements.hueRange.value),
    })
  }

  function setStatus(elements, message, kind) {
    elements.status.textContent = message
    elements.status.dataset.kind = kind
  }

  function syncViewerCopy(elements, viewMode) {
    if (viewMode === 'triangle') {
      elements.viewTitle.textContent = 'Gamut map'
      elements.viewDescription.textContent = 'Triangle mode: fixed hue with lightness across the base and chroma toward the apex.'
      elements.canvasView.dataset.viewMode = 'triangle'
      elements.canvasView.setAttribute('aria-label', 'OKLCH triangle picker with fixed hue, lightness, and chroma')
      return
    }

    if (viewMode === '3d') {
      elements.viewTitle.textContent = 'Gamut map'
      elements.viewDescription.textContent = 'Volume mode: drag to rotate hue, chroma, and lightness in OKLCH space.'
      elements.canvasView.dataset.viewMode = '3d'
      elements.canvasView.setAttribute('aria-label', 'Rotatable 3D OKLCH gamut volume')
      return
    }

    elements.viewTitle.textContent = 'Gamut map'
    elements.viewDescription.textContent = 'Plane mode: fixed lightness with a labeled gamut boundary.'
    elements.canvasView.dataset.viewMode = '2d'
    elements.canvasView.setAttribute('aria-label', 'Hue by chroma OKLCH plane with gamut boundary')
  }

  function targetGamutLabel(value) {
    return value === 'p3' ? 'Display P3' : 'sRGB'
  }

  function normalizeHue(value) {
    return ((value % 360) + 360) % 360
  }

  function formatMetric(value) {
    return Number.isFinite(value) ? value.toFixed(5) : 'n/a'
  }

  function clearCanvas(canvas) {
    const ctx = canvas.getContext('2d')
    if (!ctx) return
    const { width, height } = prepareCanvas(canvas)
    ctx.clearRect(0, 0, width, height)
  }

  function prepareCanvas(canvas) {
    const rect = canvas.getBoundingClientRect()
    const width = Math.max(1, rect.width || 640)
    const height = Math.max(1, rect.height || 360)
    const ratio = Math.min(window.devicePixelRatio || 1, 2)

    canvas.width = Math.floor(width * ratio)
    canvas.height = Math.floor(height * ratio)

    const ctx = canvas.getContext('2d')
    ctx.setTransform(ratio, 0, 0, ratio, 0, 0)

    return { ctx, width, height }
  }

  function drawGamutSlice(canvas, source, mappings, targetGamut) {
    const prepared = preparePixelCanvas(canvas, targetGamut)
    const { ctx, width, height, pixelWidth, pixelHeight, ratio } = prepared
    const fixedLightness = clamp(source.l, 0.02, 0.98)
    const mappedColors = getMappedColors(mappings)
    const viewMaxC = getPlaneMaxChroma(fixedLightness, targetGamut, source.c, ...mappedColors.map((color) => color.c))

    drawCanvasBackground(ctx, pixelWidth, pixelHeight)
    putPlaneImage(ctx, buildHueChromaPlane(pixelWidth, pixelHeight, fixedLightness, viewMaxC, targetGamut, prepared.colorSpace))

    ctx.setTransform(ratio, 0, 0, ratio, 0, 0)
    drawRectangularGrid(ctx, width, height, 'Hue', 'Chroma')
    drawHueChromaContours(ctx, width, height, fixedLightness, viewMaxC, targetGamut)
    if (targetGamut === 'p3') drawHueChromaContours(ctx, width, height, fixedLightness, viewMaxC, 'srgb', true)
    for (const mapping of mappings) {
      drawMappingLine(
        ctx,
        hueChromaPoint(source, fixedLightness, viewMaxC, width, height),
        hueChromaPoint(mapping.result.color, fixedLightness, viewMaxC, width, height),
        mapping.stroke,
      )
    }
    drawHueChromaMarker(ctx, source, fixedLightness, viewMaxC, width, height, 'Source', '#111111')
    for (const mapping of mappings) {
      drawHueChromaMarker(ctx, mapping.result.color, fixedLightness, viewMaxC, width, height, mapping.label, mapping.stroke)
    }

    ctx.fillStyle = '#6f6f6a'
    ctx.font = '12px ui-monospace, SFMono-Regular, Consolas, monospace'
    ctx.fillText(`L ${(fixedLightness * 100).toFixed(1)}%`, 16, 24)
    ctx.fillText(`${targetGamutLabel(targetGamut)} boundary`, 16, height - 16)
  }


  function drawGamutTriangle(canvas, source, mappings, targetGamut) {
    const prepared = preparePixelCanvas(canvas, targetGamut)
    const { ctx, width, height, pixelWidth, pixelHeight, ratio } = prepared
    const fixedHue = normalizeHue(source.h)
    const frame = getTriangleFrame(pixelWidth, pixelHeight)
    const data = new Uint8ClampedArray(pixelWidth * pixelHeight * 4)
    let offset = 0

    for (let y = 0; y < pixelHeight; y += 1) {
      for (let x = 0; x < pixelWidth; x += 1) {
        const point = trianglePointToOklch(x, y, frame, fixedHue, targetGamut)
        if (!point) {
          data[offset] = 246
          data[offset + 1] = 246
          data[offset + 2] = 243
          data[offset + 3] = 255
        } else {
          writeOklchSample(data, offset, point.l, point.c, point.h, targetGamut, prepared.colorSpace)
        }
        offset += 4
      }
    }

    drawCanvasBackground(ctx, pixelWidth, pixelHeight)
    putPlaneImage(ctx, createImageData(data, pixelWidth, pixelHeight, prepared.colorSpace))

    ctx.setTransform(ratio, 0, 0, ratio, 0, 0)
    const displayFrame = getTriangleFrame(width, height)
    drawTriangleFrame(ctx, displayFrame, targetGamut)
    for (const mapping of mappings) {
      drawMappingLine(
        ctx,
        triangleMarkerPoint(source, fixedHue, targetGamut, displayFrame),
        triangleMarkerPoint(mapping.result.color, fixedHue, targetGamut, displayFrame),
        mapping.stroke,
      )
    }
    drawTriangleMarker(ctx, source, fixedHue, targetGamut, displayFrame, 'Source', '#111111')
    for (const mapping of mappings) {
      drawTriangleMarker(ctx, mapping.result.color, fixedHue, targetGamut, displayFrame, mapping.label, mapping.stroke)
    }

    ctx.fillStyle = '#6f6f6a'
    ctx.font = '12px ui-monospace, SFMono-Regular, Consolas, monospace'
    ctx.fillText(`H ${fixedHue.toFixed(1)} deg`, 16, 24)
    ctx.fillText(`${targetGamutLabel(targetGamut)} triangle`, 16, height - 16)
  }

  function getTriangleFrame(width, height) {
    const marginX = Math.max(24, width * 0.07)
    const marginTop = Math.max(28, height * 0.06)
    const marginBottom = Math.max(38, height * 0.08)
    return {
      x: marginX,
      y: marginTop,
      width: Math.max(1, width - marginX * 2),
      height: Math.max(1, height - marginTop - marginBottom),
    }
  }

  function trianglePointToOklch(x, y, frame, hue, targetGamut) {
    const px = (x - frame.x) / frame.width
    const py = 1 - (y - frame.y) / frame.height
    if (px < 0 || px > 1 || py < 0 || py > 1) return null

    const halfWidth = (1 - py) * 0.5
    const left = 0.5 - halfWidth
    const right = 0.5 + halfWidth
    if (px < left || px > right) return null

    const l = py > 0.999 ? 0.5 : clamp((px - left) / Math.max(0.001, right - left), 0, 1)
    const cMax = oklch_chroma_max(l, hue, targetGamut) || 0
    return { l, c: py * cMax, h: hue }
  }

  function drawTriangleFrame(ctx, frame, targetGamut) {
    const apex = { x: frame.x + frame.width * 0.5, y: frame.y }
    const left = { x: frame.x, y: frame.y + frame.height }
    const right = { x: frame.x + frame.width, y: frame.y + frame.height }

    ctx.save()
    ctx.strokeStyle = '#ffffff'
    ctx.lineWidth = 3
    ctx.shadowColor = 'rgb(0 0 0 / 0.28)'
    ctx.shadowBlur = 4
    ctx.beginPath()
    ctx.moveTo(apex.x, apex.y)
    ctx.lineTo(right.x, right.y)
    ctx.lineTo(left.x, left.y)
    ctx.closePath()
    ctx.stroke()

    ctx.shadowBlur = 0
    ctx.strokeStyle = 'rgb(20 20 20 / 0.18)'
    ctx.lineWidth = 1
    for (let index = 1; index < 5; index += 1) {
      const t = index / 5
      ctx.beginPath()
      ctx.moveTo(frame.x + frame.width * (0.5 - (1 - t) * 0.5), frame.y + frame.height * (1 - t))
      ctx.lineTo(frame.x + frame.width * (0.5 + (1 - t) * 0.5), frame.y + frame.height * (1 - t))
      ctx.stroke()
    }

    ctx.fillStyle = 'rgb(20 20 20 / 0.66)'
    ctx.font = '12px ui-monospace, SFMono-Regular, Consolas, monospace'
    ctx.fillText('Black', left.x + 4, left.y - 12)
    ctx.fillText('White', right.x - 54, right.y - 12)
    ctx.fillText(targetGamutLabel(targetGamut), frame.x + frame.width - 86, frame.y + 18)
    ctx.restore()
  }

  function drawTriangleMarker(ctx, color, fixedHue, targetGamut, frame, label, fill) {
    const point = triangleMarkerPoint(color, fixedHue, targetGamut, frame)
    drawMarker(ctx, point.x, point.y, label, fill, Math.abs(normalizeHue(color.h) - fixedHue) > 0.01 ? 'fixed H' : '')
  }

  function triangleMarkerPoint(color, fixedHue, targetGamut, frame) {
    const l = clamp(color.l, 0, 1)
    const cMax = oklch_chroma_max(l, fixedHue, targetGamut) || 0.001
    const y = clamp(color.c / cMax, 0, 1)
    const left = 0.5 - (1 - y) * 0.5
    const right = 0.5 + (1 - y) * 0.5
    const x = left + l * (right - left)
    return { x: frame.x + x * frame.width, y: frame.y + (1 - y) * frame.height }
  }

  function drawLightnessChromaSlice(canvas, source, result, targetGamut) {
    const prepared = preparePixelCanvas(canvas, targetGamut)
    const { ctx, width, height, pixelWidth, pixelHeight, ratio } = prepared
    const fixedHue = normalizeHue(source.h)
    const viewMaxC = getLightnessSliceMaxChroma(fixedHue, targetGamut, source.c, result?.c ?? source.c)

    drawCanvasBackground(ctx, pixelWidth, pixelHeight)
    putPlaneImage(ctx, buildLightnessChromaPlane(pixelWidth, pixelHeight, fixedHue, viewMaxC, targetGamut, prepared.colorSpace))

    ctx.setTransform(ratio, 0, 0, ratio, 0, 0)
    drawRectangularGrid(ctx, width, height, 'Lightness', 'Chroma')
    drawLightnessChromaContours(ctx, width, height, fixedHue, viewMaxC, targetGamut)
    if (targetGamut === 'p3') drawLightnessChromaContours(ctx, width, height, fixedHue, viewMaxC, 'srgb', true)
    drawLightnessChromaMarker(ctx, source, fixedHue, viewMaxC, width, height, 'Source', '#111111')
    if (result) {
      drawLightnessChromaMarker(ctx, result, fixedHue, viewMaxC, width, height, 'Result', targetGamut === 'p3' ? '#f05a00' : '#111111')
    }

    ctx.fillStyle = '#6f6f6a'
    ctx.font = '12px ui-monospace, SFMono-Regular, Consolas, monospace'
    ctx.fillText(`H ${fixedHue.toFixed(1)} deg`, 16, 24)
    ctx.fillText(`${targetGamutLabel(targetGamut)} boundary`, 16, height - 16)
  }

  function putPlaneImage(ctx, imageData) {
    ctx.putImageData(imageData, 0, 0)
  }

  function buildHueChromaPlane(width, height, lightness, viewMaxC, targetGamut, colorSpace) {
    const data = new Uint8ClampedArray(width * height * 4)
    let offset = 0

    for (let y = 0; y < height; y += 1) {
      const chroma = (1 - y / Math.max(1, height - 1)) * viewMaxC
      for (let x = 0; x < width; x += 1) {
        const hue = (x / Math.max(1, width - 1)) * 360
        writeOklchSample(data, offset, lightness, chroma, hue, targetGamut, colorSpace)
        offset += 4
      }
    }

    return createImageData(data, width, height, colorSpace)
  }

  function buildLightnessChromaPlane(width, height, hue, viewMaxC, targetGamut, colorSpace) {
    const data = new Uint8ClampedArray(width * height * 4)
    let offset = 0

    for (let y = 0; y < height; y += 1) {
      const chroma = (1 - y / Math.max(1, height - 1)) * viewMaxC
      for (let x = 0; x < width; x += 1) {
        const lightness = x / Math.max(1, width - 1)
        writeOklchSample(data, offset, lightness, chroma, hue, targetGamut, colorSpace)
        offset += 4
      }
    }

    return createImageData(data, width, height, colorSpace)
  }

  function writeOklchSample(data, offset, lightness, chroma, hue, targetGamut, colorSpace) {
    const target = oklchToLinearRgbSpace({ l: lightness, c: chroma, h: hue }, targetGamut)
    const reachable = isRgbInGamut(target)

    if (!reachable) {
      data[offset] = 238
      data[offset + 1] = 238
      data[offset + 2] = 232
      data[offset + 3] = 96
      return
    }

    const display = colorSpace === 'display-p3' ? target : oklchToLinearRgbSpace({ l: lightness, c: chroma, h: hue }, 'srgb')
    const encoded = encodeRgb(display)
    data[offset] = encoded.r
    data[offset + 1] = encoded.g
    data[offset + 2] = encoded.b
    data[offset + 3] = 255
  }

  function drawHueChromaContours(ctx, width, height, lightness, viewMaxC, targetGamut, muted = false) {
    const grid = buildContourGrid(96, 52, (x, y) => {
      const hue = (x / 96) * 360
      const chroma = (1 - y / 52) * viewMaxC
      return oklch_in_gamut(lightness, chroma, hue, targetGamut)
    })
    drawContourGrid(ctx, grid, width, height, targetGamut, muted)
  }

  function drawLightnessChromaContours(ctx, width, height, hue, viewMaxC, targetGamut, muted = false) {
    const grid = buildContourGrid(80, 52, (x, y) => {
      const lightness = x / 80
      const chroma = (1 - y / 52) * viewMaxC
      return oklch_in_gamut(lightness, chroma, hue, targetGamut)
    })
    drawContourGrid(ctx, grid, width, height, targetGamut, muted)
  }

  function buildContourGrid(columns, rows, sample) {
    const values = []
    for (let y = 0; y <= rows; y += 1) {
      const row = []
      for (let x = 0; x <= columns; x += 1) {
        row.push(Boolean(sample(x, y)))
      }
      values.push(row)
    }
    return { columns, rows, values }
  }

  function drawContourGrid(ctx, grid, width, height, targetGamut, muted) {
    const cellWidth = width / grid.columns
    const cellHeight = height / grid.rows

    ctx.save()
    ctx.strokeStyle = muted ? 'rgb(20 20 20 / 0.42)' : '#ffffff'
    ctx.lineWidth = muted ? 1.2 : 3.2
    ctx.shadowColor = muted ? 'transparent' : 'rgb(0 0 0 / 0.34)'
    ctx.shadowBlur = muted ? 0 : 4
    ctx.beginPath()

    for (let y = 0; y < grid.rows; y += 1) {
      for (let x = 0; x < grid.columns; x += 1) {
        const topLeft = grid.values[y][x]
        const topRight = grid.values[y][x + 1]
        const bottomRight = grid.values[y + 1][x + 1]
        const bottomLeft = grid.values[y + 1][x]

        const points = []
        if (topLeft !== topRight) points.push({ x: x + 0.5, y })
        if (topRight !== bottomRight) points.push({ x: x + 1, y: y + 0.5 })
        if (bottomLeft !== bottomRight) points.push({ x: x + 0.5, y: y + 1 })
        if (topLeft !== bottomLeft) points.push({ x, y: y + 0.5 })

        for (let index = 0; index + 1 < points.length; index += 2) {
          ctx.moveTo(points[index].x * cellWidth, points[index].y * cellHeight)
          ctx.lineTo(points[index + 1].x * cellWidth, points[index + 1].y * cellHeight)
        }
      }
    }

    ctx.stroke()
    ctx.shadowBlur = 0

    const label = targetGamutLabel(targetGamut)
    const labelX = muted ? width - 86 : width - 74
    const labelY = muted ? 36 : height - 34
    ctx.fillStyle = muted ? 'rgb(20 20 20 / 0.56)' : 'rgb(20 20 20 / 0.78)'
    ctx.font = '12px ui-monospace, SFMono-Regular, Consolas, monospace'
    ctx.fillText(label, labelX, labelY)
    ctx.restore()
  }

  function drawRectangularGrid(ctx, width, height, xLabel, yLabel) {
    ctx.save()
    ctx.strokeStyle = 'rgb(20 20 20 / 0.13)'
    ctx.lineWidth = 1

    for (let index = 1; index < 6; index += 1) {
      const x = (width * index) / 6
      const y = (height * index) / 6
      ctx.beginPath()
      ctx.moveTo(x, 0)
      ctx.lineTo(x, height)
      ctx.stroke()
      ctx.beginPath()
      ctx.moveTo(0, y)
      ctx.lineTo(width, y)
      ctx.stroke()
    }

    ctx.fillStyle = 'rgb(20 20 20 / 0.62)'
    ctx.font = '11px ui-monospace, SFMono-Regular, Consolas, monospace'
    ctx.fillText(xLabel, width - 70, height - 16)
    ctx.save()
    ctx.translate(18, 70)
    ctx.rotate(-Math.PI / 2)
    ctx.fillText(yLabel, 0, 0)
    ctx.restore()
    ctx.restore()
  }

  function drawHueChromaMarker(ctx, color, fixedLightness, viewMaxC, width, height, label, fill) {
    const { x, y } = hueChromaPoint(color, fixedLightness, viewMaxC, width, height)
    drawMarker(ctx, x, y, label, fill, Math.abs(color.l - fixedLightness) > 0.01 ? 'same hue/chroma, different L' : '')
  }

  function hueChromaPoint(color, _fixedLightness, viewMaxC, width, height) {
    return {
      x: (normalizeHue(color.h) / 360) * width,
      y: height - (clamp(color.c, 0, viewMaxC) / viewMaxC) * height,
    }
  }

  function drawLightnessChromaMarker(ctx, color, fixedHue, viewMaxC, width, height, label, fill) {
    const x = clamp(color.l, 0, 1) * width
    const y = height - (clamp(color.c, 0, viewMaxC) / viewMaxC) * height
    drawMarker(ctx, x, y, label, fill, Math.abs(normalizeHue(color.h) - fixedHue) > 0.01 ? 'different H' : '')
  }

  function drawMarker(ctx, x, y, label, fill, note = '') {
    ctx.beginPath()
    ctx.arc(x, y, 6, 0, Math.PI * 2)
    ctx.fillStyle = fill
    ctx.strokeStyle = '#ffffff'
    ctx.lineWidth = 2
    ctx.fill()
    ctx.stroke()
    ctx.fillStyle = '#202020'
    ctx.font = '12px ui-monospace, SFMono-Regular, Consolas, monospace'
    ctx.fillText(note ? `${label} (${note})` : label, clamp(x + 9, 8, ctx.canvas.width - 120), clamp(y - 9, 16, ctx.canvas.height - 8))
  }

  function drawMappingLine(ctx, from, to, stroke) {
    ctx.save()
    ctx.strokeStyle = stroke
    ctx.lineWidth = 2
    ctx.setLineDash([7, 6])
    ctx.globalAlpha = 0.86
    ctx.beginPath()
    ctx.moveTo(from.x, from.y)
    ctx.lineTo(to.x, to.y)
    ctx.stroke()
    ctx.setLineDash([])
    ctx.globalAlpha = 1

    const angle = Math.atan2(to.y - from.y, to.x - from.x)
    ctx.translate(to.x, to.y)
    ctx.rotate(angle)
    ctx.beginPath()
    ctx.moveTo(0, 0)
    ctx.lineTo(-8, -4)
    ctx.lineTo(-8, 4)
    ctx.closePath()
    ctx.fillStyle = stroke
    ctx.fill()
    ctx.restore()
  }

  function getMappedColors(mappings) {
    return mappings.map((mapping) => mapping.result.color).filter(Boolean)
  }

  function drawGamutVolume(canvas, source, mappings, targetGamut, rotation = { x: 0.58, y: -0.72 }) {
    const { ctx, width, height } = prepareCanvas(canvas)
    ctx.clearRect(0, 0, width, height)
    drawCanvasBackground(ctx, width, height)
    drawBoundaryGrid(ctx, width, height)

    if (targetGamut === 'p3') drawGamutShell(ctx, width, height, 'srgb', rotation, true)
    drawGamutShell(ctx, width, height, targetGamut, rotation, false)
    for (const mapping of mappings) {
      drawMappingLine(
        ctx,
        projectBoundarySample(source, width, height, rotation),
        projectBoundarySample(mapping.result.color, width, height, rotation),
        mapping.stroke,
      )
    }
    drawProjectedBoundaryMarker(ctx, source, width, height, 'Source', '#111111', rotation)
    for (const mapping of mappings) {
      drawProjectedBoundaryMarker(ctx, mapping.result.color, width, height, mapping.label, mapping.stroke, rotation)
    }

    ctx.fillStyle = '#6f6f6a'
    ctx.font = '12px ui-monospace, SFMono-Regular, Consolas, monospace'
    ctx.fillText(`${targetGamutLabel(targetGamut)} · drag to rotate`, 16, 24)
    ctx.fillText('L', width - 30, 28)
    ctx.fillText('C', width - 56, height - 18)
    ctx.fillText('H', 16, height - 18)
  }

  function drawGamutShell(ctx, width, height, targetGamut, rotation, muted) {
    const hueSteps = 36
    const lightnessSteps = 18
    const vertices = []

    for (let li = 0; li <= lightnessSteps; li += 1) {
      const l = 0.02 + (li / lightnessSteps) * 0.96
      const row = []
      for (let hi = 0; hi <= hueSteps; hi += 1) {
        const h = (hi / hueSteps) * 360
        const c = oklch_chroma_max(l, h, targetGamut) || 0
        const color = { l, c, h }
        row.push({
          color,
          projected: projectBoundarySample(color, width, height, rotation),
        })
      }
      vertices.push(row)
    }

    const faces = []
    for (let li = 0; li < lightnessSteps; li += 1) {
      for (let hi = 0; hi < hueSteps; hi += 1) {
        const a = vertices[li][hi]
        const b = vertices[li][hi + 1]
        const c = vertices[li + 1][hi + 1]
        const d = vertices[li + 1][hi]
        faces.push({
          points: [a.projected, b.projected, c.projected, d.projected],
          css: muted ? 'rgb(25 25 25 / 0.13)' : formatOklch(a.color),
          depth: (a.projected.depth + b.projected.depth + c.projected.depth + d.projected.depth) / 4,
        })
      }
    }

    faces.sort((a, b) => a.depth - b.depth)

    ctx.save()
    ctx.globalAlpha = muted ? 0.72 : 0.92
    for (const face of faces) {
      ctx.beginPath()
      ctx.moveTo(face.points[0].x, face.points[0].y)
      ctx.lineTo(face.points[1].x, face.points[1].y)
      ctx.lineTo(face.points[2].x, face.points[2].y)
      ctx.lineTo(face.points[3].x, face.points[3].y)
      ctx.closePath()
      ctx.fillStyle = face.css
      ctx.fill()
    }

    ctx.globalAlpha = muted ? 0.35 : 0.48
    ctx.strokeStyle = muted ? 'rgb(20 20 20 / 0.35)' : 'rgb(255 255 255 / 0.7)'
    ctx.lineWidth = muted ? 0.7 : 0.8
    for (let li = 0; li <= lightnessSteps; li += 3) {
      drawProjectedPolyline(ctx, vertices[li].map((vertex) => vertex.projected))
    }
    for (let hi = 0; hi <= hueSteps; hi += 6) {
      drawProjectedPolyline(ctx, vertices.map((row) => row[hi].projected))
    }
    ctx.restore()
  }

  function drawProjectedPolyline(ctx, points) {
    if (points.length < 2) return
    ctx.beginPath()
    ctx.moveTo(points[0].x, points[0].y)
    for (let index = 1; index < points.length; index += 1) {
      ctx.lineTo(points[index].x, points[index].y)
    }
    ctx.stroke()
  }

  function drawBoundaryGrid(ctx, width, height) {
    ctx.save()
    ctx.strokeStyle = 'rgb(20 20 20 / 0.11)'
    ctx.lineWidth = 1
    for (let i = 0; i <= 5; i += 1) {
      const y = 30 + i * ((height - 62) / 5)
      ctx.beginPath()
      ctx.moveTo(28, y)
      ctx.lineTo(width - 28, y + 16)
      ctx.stroke()
    }
    ctx.restore()
  }

  function drawBoundarySamples(ctx, samples, width, height, alpha, muted, rotation) {
    const projected = samples
      .map((sample) => ({ ...sample, projected: projectBoundarySample(sample, width, height, rotation) }))
      .sort((a, b) => a.projected.depth - b.projected.depth)

    ctx.save()
    ctx.globalAlpha = alpha
    for (const sample of projected) {
      ctx.beginPath()
      ctx.arc(sample.projected.x, sample.projected.y, muted ? 1.1 : 1.65, 0, Math.PI * 2)
      ctx.fillStyle = muted ? 'rgb(20 20 20 / 0.55)' : sample.css
      ctx.fill()
    }
    ctx.restore()
  }

  function drawProjectedBoundaryMarker(ctx, color, width, height, label, fill, rotation) {
    const point = projectBoundarySample(color, width, height, rotation)
    drawMarker(ctx, point.x, point.y, label, fill)
  }

  function buildGamutBoundarySamples(gamut, steps) {
    const samples = []
    const add = (r, g, b) => {
      const color = linearRgbSpaceToOklch({ r, g, b }, gamut)
      if (!Number.isFinite(color.h)) return
      samples.push({ ...color, css: rgbSpaceCss({ r, g, b }, gamut) })
    }

    for (let i = 0; i <= steps; i += 1) {
      const a = i / steps
      for (let j = 0; j <= steps; j += 1) {
        const b = j / steps
        add(0, a, b)
        add(1, a, b)
        add(a, 0, b)
        add(a, 1, b)
        add(a, b, 0)
        add(a, b, 1)
      }
    }

    return samples
  }

  function projectBoundarySample(color, width, height, rotation = { x: 0.58, y: -0.72 }) {
    const hue = (normalizeHue(color.h) * Math.PI) / 180
    const radius = color.c * 2.9
    const x0 = Math.cos(hue) * radius
    const z0 = Math.sin(hue) * radius
    const y0 = (color.l - 0.5) * 1.25
    const rotateY = rotation.y
    const rotateX = rotation.x
    const x1 = x0 * Math.cos(rotateY) - z0 * Math.sin(rotateY)
    const z1 = x0 * Math.sin(rotateY) + z0 * Math.cos(rotateY)
    const y1 = y0 * Math.cos(rotateX) - z1 * Math.sin(rotateX)
    const z2 = y0 * Math.sin(rotateX) + z1 * Math.cos(rotateX)
    const scale = Math.min(width, height) * 0.62

    return {
      x: width / 2 + x1 * scale,
      y: height * 0.54 - y1 * scale,
      depth: z2,
    }
  }

  function preparePixelCanvas(canvas, gamut) {
    const rect = canvas.getBoundingClientRect()
    const width = Math.max(1, rect.width || 640)
    const height = Math.max(1, rect.height || 360)
    const ratio = Math.min(window.devicePixelRatio || 1, 2)
    const pixelWidth = Math.max(1, Math.floor(width * ratio))
    const pixelHeight = Math.max(1, Math.floor(height * ratio))
    const colorSpace = gamut === 'p3' ? 'display-p3' : 'srgb'

    canvas.width = pixelWidth
    canvas.height = pixelHeight

    let ctx = canvas.getContext('2d', { colorSpace })
    if (!ctx) ctx = canvas.getContext('2d')
    ctx.setTransform(1, 0, 0, 1, 0, 0)

    return { ctx, width, height, pixelWidth, pixelHeight, ratio, colorSpace }
  }

  function createImageData(data, width, height, colorSpace) {
    try {
      return new ImageData(data, width, height, { colorSpace })
    } catch {
      return new ImageData(data, width, height)
    }
  }

  function getPlaneMaxChroma(l, gamut, ...extraChroma) {
    let max = 0.12
    for (let hue = 0; hue <= 360; hue += 4) {
      max = Math.max(max, oklch_chroma_max(l, hue, gamut) || 0)
    }
    for (const c of extraChroma) {
      if (Number.isFinite(c)) max = Math.max(max, c * 1.08)
    }
    return clamp(max, 0.12, 0.42)
  }

  function getLightnessSliceMaxChroma(hue, gamut, ...extraChroma) {
    let max = 0.12
    for (let l = 0.02; l <= 0.98; l += 0.02) {
      max = Math.max(max, oklch_chroma_max(l, hue, gamut) || 0)
    }
    for (const c of extraChroma) {
      if (Number.isFinite(c)) max = Math.max(max, c * 1.08)
    }
    return clamp(max, 0.12, 0.42)
  }

  function oklchToLinearRgbSpace(color, space) {
    const lab = oklchToOklab(color)
    const xyz = oklabToXyz(lab)
    return space === 'p3' ? xyzToLinearP3(xyz) : oklabToLinearSrgb(lab)
  }

  function linearRgbSpaceToOklch(rgb, space) {
    const xyz = space === 'p3' ? linearP3ToXyz(rgb) : linearSrgbToXyz(rgb)
    return oklabToOklch(xyzToOklab(xyz))
  }

  function oklchToOklab(color) {
    const hue = (normalizeHue(color.h) * Math.PI) / 180
    return {
      l: color.l,
      a: color.c * Math.cos(hue),
      b: color.c * Math.sin(hue),
    }
  }

  function oklabToOklch(lab) {
    const c = Math.sqrt(lab.a * lab.a + lab.b * lab.b)
    return {
      l: lab.l,
      c,
      h: c < 0.000001 ? 0 : normalizeHue((Math.atan2(lab.b, lab.a) * 180) / Math.PI),
    }
  }

  function oklabToLinearSrgb(lab) {
    const l_ = lab.l + 0.3963377774 * lab.a + 0.2158037573 * lab.b
    const m_ = lab.l - 0.1055613458 * lab.a - 0.0638541728 * lab.b
    const s_ = lab.l - 0.0894841775 * lab.a - 1.291485548 * lab.b
    const l = l_ * l_ * l_
    const m = m_ * m_ * m_
    const s = s_ * s_ * s_
    return {
      r: 4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
      g: -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
      b: -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s,
    }
  }

  function linearSrgbToXyz(rgb) {
    return {
      x: 0.4124564 * rgb.r + 0.3575761 * rgb.g + 0.1804375 * rgb.b,
      y: 0.2126729 * rgb.r + 0.7151522 * rgb.g + 0.072175 * rgb.b,
      z: 0.0193339 * rgb.r + 0.119192 * rgb.g + 0.9503041 * rgb.b,
    }
  }

  function linearP3ToXyz(rgb) {
    return {
      x: 0.4865709486 * rgb.r + 0.2656676932 * rgb.g + 0.1982172852 * rgb.b,
      y: 0.2289745641 * rgb.r + 0.6917385218 * rgb.g + 0.0792869141 * rgb.b,
      z: 0.0451133819 * rgb.g + 1.0439443689 * rgb.b,
    }
  }

  function xyzToLinearP3(xyz) {
    return {
      r: 2.4934969119 * xyz.x - 0.9313836179 * xyz.y - 0.4027107845 * xyz.z,
      g: -0.8294889696 * xyz.x + 1.7626640603 * xyz.y + 0.0236246858 * xyz.z,
      b: 0.0358458302 * xyz.x - 0.0761723893 * xyz.y + 0.956884524 * xyz.z,
    }
  }

  function oklabToXyz(lab) {
    const l_ = lab.l + 0.3963377774 * lab.a + 0.2158037573 * lab.b
    const m_ = lab.l - 0.1055613458 * lab.a - 0.0638541728 * lab.b
    const s_ = lab.l - 0.0894841775 * lab.a - 1.291485548 * lab.b
    const l = l_ * l_ * l_
    const m = m_ * m_ * m_
    const s = s_ * s_ * s_
    return {
      x: 1.2270138511 * l - 0.5577999807 * m + 0.281256149 * s,
      y: -0.0405801784 * l + 1.1122568696 * m - 0.0716766787 * s,
      z: -0.0763812845 * l - 0.4214819784 * m + 1.5861632204 * s,
    }
  }

  function xyzToOklab(xyz) {
    const l = Math.cbrt(0.8190224432 * xyz.x + 0.3619062563 * xyz.y - 0.1288737826 * xyz.z)
    const m = Math.cbrt(0.0329836672 * xyz.x + 0.9292868469 * xyz.y + 0.0361446682 * xyz.z)
    const s = Math.cbrt(0.0481771996 * xyz.x + 0.2642395249 * xyz.y + 0.6335478258 * xyz.z)
    return {
      l: 0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s,
      a: 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s,
      b: 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s,
    }
  }

  function isRgbInGamut(rgb) {
    const epsilon = 0.00002
    return rgb.r >= -epsilon && rgb.r <= 1 + epsilon && rgb.g >= -epsilon && rgb.g <= 1 + epsilon && rgb.b >= -epsilon && rgb.b <= 1 + epsilon
  }

  function encodeRgb(rgb) {
    return {
      r: Math.round(linearToEncodedByte(rgb.r)),
      g: Math.round(linearToEncodedByte(rgb.g)),
      b: Math.round(linearToEncodedByte(rgb.b)),
    }
  }

  function linearToEncodedByte(value) {
    const channel = clamp(value, 0, 1)
    const encoded = channel <= 0.0031308 ? 12.92 * channel : 1.055 * channel ** (1 / 2.4) - 0.055
    return clamp(encoded * 255, 0, 255)
  }

  function rgbSpaceCss(rgb, gamut) {
    const encoded = {
      r: linearToUnit(rgb.r),
      g: linearToUnit(rgb.g),
      b: linearToUnit(rgb.b),
    }
    if (gamut === 'p3') return `color(display-p3 ${encoded.r.toFixed(4)} ${encoded.g.toFixed(4)} ${encoded.b.toFixed(4)})`
    return `rgb(${Math.round(encoded.r * 255)} ${Math.round(encoded.g * 255)} ${Math.round(encoded.b * 255)})`
  }

  function linearToUnit(value) {
    return linearToEncodedByte(value) / 255
  }

  function drawCanvasBackground(ctx, width, height) {
    ctx.fillStyle = '#ffffff'
    ctx.fillRect(0, 0, width, height)
    ctx.strokeStyle = 'rgb(20 20 20 / 0.08)'
    ctx.lineWidth = 1
    for (let x = 24; x < width; x += 48) {
      ctx.beginPath()
      ctx.moveTo(x, 0)
      ctx.lineTo(x, height)
      ctx.stroke()
    }
    for (let y = 24; y < height; y += 48) {
      ctx.beginPath()
      ctx.moveTo(0, y)
      ctx.lineTo(width, y)
      ctx.stroke()
    }
  }

  function clamp(value, min, max) {
    return Math.min(max, Math.max(min, value))
  }
</script>

