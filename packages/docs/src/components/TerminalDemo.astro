---
const { scenario = 'audit' } = Astro.props

const scenarios = {
  audit: [
    { cls: 't-cmd', text: 'okcolor audit src/styles.css' },
    { cls: 't-out', text: 'Scanning src/styles.css ...' },
    { cls: 't-out-highlight', text: 'Found 47 legacy colors:' },
    { cls: 't-out-indent', text: 'hex:     23' },
    { cls: 't-out-indent', text: 'rgb():   12' },
    { cls: 't-out-indent', text: 'hsl():   8' },
    { cls: 't-out-indent', text: 'named:   4' },
    { cls: 't-cmd', text: 'okcolor src/styles.css -o dist/styles.css' },
    { cls: 't-out-success', text: '\u2713 Transformed 47 colors in 0.83 ms' },
    { cls: 't-cmd', text: 'okcolor check src/ --max-legacy-colors=5' },
    { cls: 't-out-success', text: '\u2713 3 legacy colors found (max: 5) \u2014 passed' },
    { cls: 't-cmd', text: '' }
  ],
  transform: [
    { cls: 't-cmd', text: 'okcolor src/styles.css -o dist/styles.css' },
    { cls: 't-out', text: 'okcolor v1.0.0' },
    { cls: 't-out', text: '' },
    { cls: 't-out', text: '  .btn  \u2192  #3b82f6 \u2192 oklch(61.78% 0.17686 250.43)' },
    { cls: 't-out', text: '  .card \u2192  #ff0000 \u2192 oklch(62.8% 0.25768 29.23)' },
    { cls: 't-out', text: '  .hero \u2192  hsl(145,63%,49%) \u2192 oklch(67.72% 0.19 152.54)' },
    { cls: 't-out', text: '  .nav  \u2192  rgb(0 0 0 / 20%) \u2192 oklch(0% 0 0 / 0.2)' },
    { cls: 't-out', text: '  .link \u2192  blue \u2192 oklch(45.2% 0.31321 264.05)' },
    { cls: 't-out', text: '' },
    { cls: 't-out-success', text: '\u2713 5 colors transformed. 3 gradients updated.' },
    { cls: 't-out', text: '\u2713 Output written to dist/styles.css' },
    { cls: 't-cmd', text: '' }
  ],
  gradient: [
    { cls: 't-cmd', text: 'okcolor src/hero.css -o dist/hero.css' },
    { cls: 't-out', text: 'Transforming src/hero.css ...' },
    { cls: 't-out', text: '' },
    { cls: 't-arrow', text: '  \u2192 linear-gradient(#f00, #00f)' },
    { cls: 't-out-success', text: '  \u2192 linear-gradient(in oklch,' },
    { cls: 't-out-success', text: '       oklch(62.8% 0.25768 29.23),' },
    { cls: 't-out-success', text: '       oklch(45.2% 0.31321 264.05))' },
    { cls: 't-out', text: '' },
    { cls: 't-out', text: 'Gradients now interpolate in perceptually uniform space' },
    { cls: 't-out-success', text: '\u2713 Done in 0.21 ms' },
    { cls: 't-cmd', text: '' }
  ],
  doctor: [
    { cls: 't-cmd', text: 'okcolor doctor src/styles.css' },
    { cls: 't-out', text: 'Diagnosing src/styles.css ...' },
    { cls: 't-out', text: '' },
    { cls: 't-out', text: '  Colors found:        47' },
    { cls: 't-out', text: '  Colors converted:    44 \u2713' },
    { cls: 't-out', text: '  Modern (passthrough): 3 \u2713' },
    { cls: 't-out-highlight', text: '  Malformed values:     0' },
    { cls: 't-out-success', text: '  Low contrast pairs:   0 \u2713' },
    { cls: 't-out', text: '' },
    { cls: 't-out', text: 'All checks passed. No issues found.' },
    { cls: 't-cmd', text: '' }
  ]
}

const lines = scenarios[scenario] || scenarios.audit
---

<div class="terminal-demo">
  <div class="terminal-demo-header">
    <span class="terminal-demo-dot"></span>
    <span class="terminal-demo-dot"></span>
    <span class="terminal-demo-dot"></span>
    <span class="terminal-demo-title">okcolor</span>
  </div>
  <div class="terminal-demo-body">
    {lines.map((line) => (
      <div class="t-line">
        {line.text === '' ? (
          <span class="t-prompt">$</span>
        ) : line.cls === 't-cmd' ? (
          <><span class="t-prompt">$</span><span class={line.cls}>{line.text}</span></>
        ) : (
          <span class={line.cls}>{line.text}</span>
        )}
      </div>
    ))}
  </div>
</div>
