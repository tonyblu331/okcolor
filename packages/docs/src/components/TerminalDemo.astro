---
const { scenario = 'audit' } = Astro.props

const scenarios = {
  audit: [
    { cls: 't-cmd', text: 'okcolor audit ./src' },
    { cls: 't-out', text: 'Scanning ./src ...' },
    { cls: 't-out-highlight', text: 'Found 47 legacy colors:' },
    { cls: 't-out-indent', text: 'hex:     23' },
    { cls: 't-out-indent', text: 'rgb():   12' },
    { cls: 't-out-indent', text: 'hsl():   8' },
    { cls: 't-out-indent', text: 'named:   4' },
    { cls: 't-cmd', text: 'okcolor check ./src --max-legacy-colors=50' },
    { cls: 't-out-success', text: '\u2713 Color check passed (47 legacy colors)' },
    { cls: 't-cmd', text: '' }
  ],
  transform: [
    { cls: 't-cmd', text: 'okcolor convert "#3b82f6" --to oklch' },
    { cls: 't-out-success', text: 'oklch(61.78% 0.17686 250.43)' },
    { cls: 't-cmd', text: 'okcolor expand "#ff5a00" --gamut p3 --format json' },
    { cls: 't-out', text: '  "strategy": "expand",' },
    { cls: 't-out', text: '  "gamut": "p3",' },
    { cls: 't-out', text: '  "css": "oklch(...)"' },
    { cls: 't-out', text: '' },
    { cls: 't-out', text: 'Use the Vite plugin for automatic CSS file transforms.' },
    { cls: 't-cmd', text: '' }
  ],
  gradient: [
    { cls: 't-cmd', text: 'okcolor audit ./src --format=json' },
    { cls: 't-out', text: '  "mode": "css-debt",' },
    { cls: 't-out', text: '  "totals": {' },
    { cls: 't-out-success', text: '    "gradientCount": 3,' },
    { cls: 't-out-success', text: '    "legacyCount": 47' },
    { cls: 't-out', text: '  }' },
    { cls: 't-out', text: '' },
    { cls: 't-out', text: 'Run okColor() in Vite to modernize gradients at build time.' },
    { cls: 't-cmd', text: '' }
  ],
  scope: [
    { cls: 't-cmd', text: 'okcolor scope ./src' },
    { cls: 't-out', text: '  okcolor scope' },
    { cls: 't-out', text: '' },
    { cls: 't-out', text: '  Scanned 12 file(s)' },
    { cls: 't-out-success', text: '  \u2713 No issues found' },
    { cls: 't-out', text: '' },
    { cls: 't-cmd', text: '' }
  ]
}

const lines = scenarios[scenario] || scenarios.audit
---

<div class="terminal-demo">
  <div class="terminal-demo-header">
    <span class="terminal-demo-dot"></span>
    <span class="terminal-demo-dot"></span>
    <span class="terminal-demo-dot"></span>
    <span class="terminal-demo-title">okcolor</span>
  </div>
  <div class="terminal-demo-body">
    {lines.map((line) => (
      <div class="t-line">
        {line.text === '' ? (
          <span class="t-prompt">$</span>
        ) : line.cls === 't-cmd' ? (
          <><span class="t-prompt">$</span><span class={line.cls}>{line.text}</span></>
        ) : (
          <span class={line.cls}>{line.text}</span>
        )}
      </div>
    ))}
  </div>
</div>
